# Dependencies & Locks
node_modules/
functions/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build Outputs (Vite/React)
dist/
build/
coverage/

# Firebase & Local Emulators
.firebase/
firebase-debug.log

# Python (MCP Server & Local Scripts)
venv/
.venv/
.env/
__pycache__/
*.pyc
antigravity-mcp-server/__pycache__/
antigravity-mcp-server/venv/
antigravity-mcp-server/.venv/
antigravity-mcp-server/.env/

# IDE & Git System Files
.git/
.vscode/
.idea/
.DS_Store

# Large Assets (AI rarely needs to read these)
*.svg
*.png
*.jpg
*.jpeg
*.ico
*.gif
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.webm
*.webp
public/

# Antigravity/Gemini Brain (CRITICAL)
# Prevents the agent from reading its own history/artifacts as code
.gemini/
.antigravity/
artifacts/

# SCORM Extract Directories (HEAVY - Skip these!)
temp_scorm_extract/
temp_scorm12_extract/
UE5ScenarioTracker-main.zip
UE5_Scenario_Tracker_SCORM12_Build.zip

# Large Backup Directories
backups/
scripts/archive/
scripts/backups/
scripts/security_backups/
scripts/deploy/
scripts/examples/
scripts/__pycache__/

# Test & Diagnostic Scripts (Not needed for AI context)
test_*.py
diagnostic_*.py
minimal_server.py

# Temporary Fix Scripts (Not needed after fixes applied)
scripts/fix_*.py
scripts/refactor_*.py
scripts/perf_fix_*.py
scripts/add_*.py
scripts/integrate_*.py

# Large Log & Output Files
test_output.txt
lint_output.json
lint_current.txt
mcp_debug.log
*.log

# MCP Debug Files
update_mcp_config.py

# Documentation (Optional: Un-comment if you want the agent to ignore old docs)
# docs/