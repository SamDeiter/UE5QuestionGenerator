#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running critical regression tests before push..."
npm test -- --run src/components/__tests__/CriticalUI.regression.test.jsx

# If tests fail, prevent push
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Critical regression tests failed!"
  echo "Fix the failing tests before pushing to main."
  echo ""
  exit 1
fi

echo "✅ All critical tests passed!"
