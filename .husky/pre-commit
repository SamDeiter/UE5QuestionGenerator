#!/usr/bin/env sh

# Block obvious secret-bearing files from ever being committed. This is a
# fast first line of defense — gitleaks runs in CI as the deeper check.
# Patterns:
#   .env, .env.local, .env.production, etc.
#   *serviceAccountKey*.json (Firebase admin SDK)
#   firebase-adminsdk-*.json (the format Firebase suggests for downloads)
#   *credentials*.json (catch-all for misnamed creds)
#
# If a match is found we list the files and exit non-zero. Bypass for a
# legitimate case requires `git commit --no-verify` (recorded in reflog).
STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -E '(^|/)\.env($|\.)|serviceAccountKey|firebase-adminsdk-.*\.json$|credentials.*\.json$' >/dev/null; then
  echo ""
  echo "🚫 pre-commit: refusing to commit a file that looks like a secret bundle:"
  echo "$STAGED" | grep -E '(^|/)\.env($|\.)|serviceAccountKey|firebase-adminsdk-.*\.json$|credentials.*\.json$' | sed 's/^/   - /'
  echo ""
  echo "If this is a false positive, re-run with: git commit --no-verify"
  exit 1
fi

npx lint-staged
