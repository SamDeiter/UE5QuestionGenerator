# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firestore named database id. Set to "ue5qg-prod" for the Epic project
# (development-317819). Leave empty/unset to use the project's "(default)"
# database (legacy ue5-questions-prod behavior).
VITE_FIRESTORE_DATABASE_ID=ue5qg-prod

# Google Gemini API (NOT RECOMMENDED - use backend proxy instead)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (recommended for production)
# VITE_API_PROXY_URL=https://your-backend.com/api
