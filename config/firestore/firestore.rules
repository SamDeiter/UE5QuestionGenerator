rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Custom claims are now the single source of truth for role checks.
    // Prerequisite: backfillCustomClaims MUST be run before these rules
    // ship — it copies role/tools from registeredUsers into the auth
    // token for every existing user. The pre-Phase-C registeredUsers
    // doc-lookup fallback is removed here because (a) doc-lookup gates
    // cost 2 Firestore reads per rule eval (latency + $$$) and (b) any
    // future relaxation of registeredUsers writes would silently become
    // a privilege-escalation cliff.
    function isAdmin() {
      return request.auth.token.role == 'admin'
        || request.auth.token.role == 'super_admin';
    }

    function isReviewer() {
      return request.auth.token.role == 'reviewer'
        || isAdmin();
    }
    
    // Version control: Require version increments by exactly 1 (no skipping)
    function versionIsIncremented() {
      return !resource.data.keys().hasAny(['version']) || 
             request.resource.data.version == resource.data.version + 1;
    }
    
    // SECURITY: Validate question data structure to prevent malformed data
    function isValidQuestion() {
      let data = request.resource.data;
      // Required fields must exist
      return data.keys().hasAll(['question', 'options', 'correct', 'creatorId', 'creatorEmail'])
        // Question text must be a non-empty string with reasonable length
        && data.question is string
        && data.question.size() > 0
        && data.question.size() < 5000
        // Options must be a map (A, B, C, D, E for MC) or string (T/F)
        && (data.options is map || data.options is string)
        // Correct answer must be a string
        && data.correct is string
        && data.correct.size() > 0
        // creatorId and creatorEmail must be strings
        && data.creatorId is string
        && data.creatorEmail is string;
    }
    
    // ============================================================
    // QUESTIONS COLLECTION (with version control)
    // ============================================================
    
    match /questions/{questionId} {
      // All authenticated users can read questions (for shared review workflow)
      allow read: if isSignedIn();
      
      // Create: Admins/Creators only - Reviewers cannot create questions
      // SECURITY: isValidQuestion() enforces schema validation
      allow create: if isSignedIn()
        && !isReviewer()  // Reviewers cannot create questions
        && isValidQuestion()  // SECURITY: Enforce valid question structure
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorEmail == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['version']) || request.resource.data.version == 1);
      
      // Update: Must be authenticated, version must increment, updatedBy must match auth
      // Special case: Admins can update any fields, Reviewers limited to specific fields
      allow update: if isSignedIn() && (
        // Standard update: Owner updates their own question with version increment
        (resource.data.creatorId == request.auth.uid 
         && request.resource.data.creatorId == request.auth.uid
         && versionIsIncremented())
        ||
        // Admin FULL override: Admins can update any fields
        isAdmin()
        ||
        // Reviewer LIMITED update: Can only modify review-specific fields
        // SECURITY: Prevents reviewers from stealing ownership or bypassing version control
        (isReviewer()
         && request.resource.data.creatorId == resource.data.creatorId  // Cannot change owner
         && request.resource.data.creatorEmail == resource.data.creatorEmail  // Cannot change creator email
         && versionIsIncremented()  // Must increment version (concurrent editing protection)
         // SECURITY: Reviewers cannot forge attribution. If they touch acceptedBy/rejectedBy/
         // humanVerifiedBy, the new value must reflect their own identity. Untouched values
         // are left alone (the affectedKeys guard below ensures we only constrain on change).
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['humanVerifiedBy'])
             || request.resource.data.humanVerifiedBy == request.auth.token.email)
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['acceptedBy'])
             || request.resource.data.acceptedBy == request.auth.uid)
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rejectedBy'])
             || request.resource.data.rejectedBy == request.auth.uid)
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              // Version and timestamps
              'version', 'updatedAt', 'firestoreUpdatedAt', 'modifiedAt', 'updatedBy',
              // Scoring fields
              'aiScore', 'scoredAt', 'scoreSource',
              // Status and rejection fields
              'status', 'rejectionReason', 'rejectionCategory', 'rejectionNotes',
              'rejectedAt', 'rejectedBy', 'acceptedAt', 'acceptedBy',
              // Review tracking fields
              'reviewedBy', 'reviewedAt', 'reviewCompletedAt',
              'reviewerName', 'reviewDuration', 'reviewStartedAt',
              // Critique fields (AI-generated, not content)
              'critique', 'critiqueScore', 'suggestedRewrite', 'improvedScore',
              'critiqueAttempts', 'previousCritiqueScore',
              // Verification fields
              'humanVerified', 'humanVerifiedBy', 'humanVerifiedAt',
              'kickedBackAt', 'kickedBackBy', 'kickedBackReason',
              // Tags and difficulty
              'tags', 'difficulty',
              // Backfill metadata
              '_backfilledHumanVerified', '_backfilledAt', 'tagsBackfilledAt',
              // Notes
              'notes'
            ]))  // SECURITY: Reviewers cannot modify question content
      );
      
      // Delete: Admins only
      allow delete: if isAdmin();
    }

    // ============================================================
    // QUESTION INDEX COLLECTION (compact read-mirror of questions)
    // ============================================================
    // Maintained exclusively by the maintainQuestionIndex Cloud Function
    // (Admin SDK, which bypasses these rules). Clients only ever READ it to
    // power the list / filters / counts / search; all writes are server-side.
    match /questionIndex/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================================
    // EDIT LOCKS COLLECTION
    // ============================================================
    
    match /edit-locks/{questionId} {
      // Read: All authenticated users (to check lock status)
      allow read: if isSignedIn();
      
      // Create/Update: Authenticated users (lock ownership checked in transaction logic)
      allow create, update: if isSignedIn()
                               && request.resource.data.userId == request.auth.uid;
      
      // Delete: Only the owner can delete their lock
      allow delete: if isSignedIn() 
                       && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // AUDIT LOG COLLECTION
    // ============================================================
    
    match /audit-log/{eventId} {
      // Read: Admins only
      allow read: if isAdmin();

      // Create: signed-in users only, with a strict shape.
      // SECURITY: Pin userId/userEmail to the caller, restrict eventType to a
      // known allowlist, and cap the writable key set so an attacker cannot
      // pad the doc with arbitrary fields. Server-issued events use the
      // Admin SDK and bypass these rules.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.eventType is string
        && request.resource.data.eventType in [
             'STATUS_CHANGE',
             'CRITIQUE_APPLIED',
             'IMPROVEMENT_APPLIED',
             'QUESTION_VERIFIED',
             'QUESTION_ACCEPTED',
             'QUESTION_REJECTED',
             'QUESTION_RESTORED',
             'TRANSLATION_ADDED',
             'TAGS_UPDATED',
             'BULK_ACCEPT',
             'BULK_REJECT',
             'BULK_DELETE',
             'BULK_CRITIQUE',
             'REVIEW_ATTEMPT',
             'REVIEW_SUCCESS',
             'REVIEW_FAILED'
           ]
        && request.resource.data.keys().hasOnly([
             'questionId', 'eventType', 'timestamp',
             'userId', 'userEmail', 'details',
             'sessionId', 'userAgent',
             'questionCount', 'questionIds'
           ]);

      // No updates or deletes (immutable log)
      allow update, delete: if false;
    }
    
    // ============================================================
    // USER SETTINGS
    // ============================================================
    
    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // ============================================================
    // API ACCESS TRACKING
    // ============================================================
    
    match /QuestionsAPIAccess/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // API USAGE (Rate Limiting & Analytics)
    // ============================================================
    
    match /apiUsage/{docId} {
      // Read: Admins only (for audit trail)
      allow read: if isAdmin();
      // Create: Cloud Functions only. functions/utils/apiUsage.js writes via
      // the Admin SDK (bypasses rules). Clients have no legitimate reason to
      // write here — the only code path that did, didn't exist — so we lock
      // it down to prevent log poisoning.
      allow create: if false;
      // Immutable - no updates or deletes
      allow update, delete: if false;
    }
    
    // ============================================================
    // INVITES COLLECTION (Managed by Cloud Functions + Admin UI)
    // ============================================================
    
    match /invites/{inviteId} {
      // Read/Write: Admins only (Cloud Functions bypass rules)
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================================
    // INVITE ATTEMPTS (Rate Limiting for Invite Validation)
    // ============================================================
    
    match /inviteAttempts/{clientId} {
      // Read: Admins only (for audit trail)
      allow read: if isAdmin();
      // Write: Cloud Functions only (no client access)
      allow write: if false;
    }
    
    // ============================================================
    // ADMINS COLLECTION
    // ============================================================
    
    match /admins/{userId} {
      // Read: Admins only (SECURITY: prevents admin enumeration)
      allow read: if isAdmin();
      // Write: Admins only
      allow write: if isAdmin();
    }
    
    // ============================================================
    // REGISTERED USERS
    // ============================================================
    
    match /registeredUsers/{userId} {
      // Read: Admins can read all, users can read their own
      allow read: if isAdmin() || isOwner(userId);
      // Create: Cloud Functions handle this (via consumeInvite)
      allow create: if false;
      // Update/Delete: Admins only
      allow update, delete: if isAdmin();
    }
    
    // ============================================================
    // TRAINING DATA (Correction Pairs for AI Fine-Tuning)
    // ============================================================
    
    match /training_data/{docId} {
      // Read: Admins only (for export)
      allow read: if isAdmin();
      // Create: Any authenticated reviewer/admin with required fields
      allow create: if isSignedIn() && (isAdmin() || isReviewer())
        && request.resource.data.keys().hasAll(['questionId', 'original', 'corrected', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.token.email;
      // Immutable - no updates or deletes
      allow update, delete: if false;
    }

    // ============================================================
    // TOOL REGISTRY
    // ============================================================
    
    match /toolRegistry/{toolId} {
      // Read: Any authenticated user
      allow read: if isSignedIn();
      // Write: Admins only
      allow write: if isAdmin();
    }
    
    // ============================================================
    // RATE LIMITS (Counter-based rate limiting - Server Only)
    // ============================================================
    
    match /rateLimits/{docId} {
      // Cloud Functions only - clients cannot access counter docs
      allow read, write: if false;
    }
    
    // ============================================================
    // DENY ALL OTHER ACCESS
    // ============================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
