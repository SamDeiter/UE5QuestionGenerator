rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.token.role == 'admin' 
        || request.auth.token.email == 'sam.deiter@epicgames.com'
        || get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.role == 'admin';
    }

    function isReviewer() {
      return get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.role == 'reviewer';
    }
    
    // Version control: Prevent version regression
    function versionNotRegressing() {
      return !resource.data.keys().hasAny(['version']) || 
             request.resource.data.version > resource.data.version;
    }
    
    // ============================================================
    // QUESTIONS COLLECTION (with version control)
    // ============================================================
    
    match /questions/{questionId} {
      // All authenticated users can read questions (for shared review workflow)
      allow read: if isSignedIn();
      
      // Create: Requires authentication, must set version = 1, must set creatorId
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorEmail == request.auth.token.email
        && (!request.resource.data.keys().hasAny(['version']) || request.resource.data.version == 1);
      
      // Update: Must be authenticated, version must increment, updatedBy must match auth
      // Special case: Admins can update specific fields without version check
      allow update: if isSignedIn() && (
        // Standard update: Owner updates their question with version increment
        (resource.data.creatorId == request.auth.uid 
         && request.resource.data.creatorId == request.auth.uid
         && versionNotRegressing())
        ||
        // Admin FULL override: Admins can update any fields
        isAdmin()
        ||
        // Reviewer override: Can update specific review-related fields only
        (isReviewer()
         && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              // Version and timestamps
              'version', 'updatedAt', 'firestoreUpdatedAt', 'modifiedAt',
              // Scoring fields
              'aiScore', 'scoredAt', 'scoreSource', 
              // Status and rejection fields
              'status', 'rejectionReason', 'rejectionCategory', 'rejectionNotes', 
              'rejectedAt', 'rejectedBy', 'acceptedAt', 'acceptedBy',
              // Review tracking fields
              'reviewedBy', 'reviewedAt', 'reviewCompletedAt', 
              'reviewerName', 'reviewDuration', 'reviewStartedAt',
              // Critique and improvement fields
              'critique', 'critiqueScore', 'suggestedRewrite', 'improvedScore', 'improvementsApplied',
              'rewriteChanges', 'critiqueAttempts', 'previousCritiqueScore',
              // Human verification fields
              'humanVerified', 'humanVerifiedBy', 'humanVerifiedAt',
              // Kick back fields
              'kickedBackAt', 'kickedBackBy', 'kickedBackReason',
              // Tags and difficulty (for re-critique and manual updates)
              'tags', 'difficulty',
              // Notes
              'notes'
            ]))
      );
      
      // Delete: Admins only
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // EDIT LOCKS COLLECTION
    // ============================================================
    
    match /edit-locks/{questionId} {
      // Read: All authenticated users (to check lock status)
      allow read: if isSignedIn();
      
      // Create/Update: Authenticated users (lock ownership checked in transaction logic)
      allow create, update: if isSignedIn()
                               && request.resource.data.userId == request.auth.uid;
      
      // Delete: Only the owner can delete their lock
      allow delete: if isSignedIn() 
                       && resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // AUDIT LOG COLLECTION
    // ============================================================
    
    match /audit-log/{eventId} {
      // Read: Admins only
      allow read: if isAdmin();
      
      // Create: All authenticated users (write-only logging)
      allow create: if isSignedIn()
                       && request.resource.data.userId == request.auth.uid;
      
      // No updates or deletes (immutable log)
      allow update, delete: if false;
    }
    
    // ============================================================
    // USER SETTINGS
    // ============================================================
    
    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // ============================================================
    // API ACCESS TRACKING
    // ============================================================
    
    match /QuestionsAPIAccess/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // API USAGE (Rate Limiting & Analytics)
    // ============================================================
    
    match /apiUsage/{docId} {
      // Read: Admins only (for audit trail)
      allow read: if isAdmin();
      // Create: Any authenticated user (Cloud Functions log usage)
      allow create: if isSignedIn();
      // Immutable - no updates or deletes
      allow update, delete: if false;
    }
    
    // ============================================================
    // INVITES COLLECTION (Managed by Cloud Functions + Admin UI)
    // ============================================================
    
    match /invites/{inviteId} {
      // Read/Write: Admins only (Cloud Functions bypass rules)
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================================
    // INVITE ATTEMPTS (Rate Limiting for Invite Validation)
    // ============================================================
    
    match /inviteAttempts/{clientId} {
      // Read: Admins only (for audit trail)
      allow read: if isAdmin();
      // Write: Cloud Functions only (no client access)
      allow write: if false;
    }
    
    // ============================================================
    // ADMINS COLLECTION
    // ============================================================
    
    match /admins/{userId} {
      // Read: Any authenticated user (to check admin status)
      allow read: if isSignedIn();
      // Write: Admins only
      allow write: if isAdmin();
    }
    
    // ============================================================
    // REGISTERED USERS
    // ============================================================
    
    match /registeredUsers/{userId} {
      // Read: Admins can read all, users can read their own
      allow read: if isAdmin() || isOwner(userId);
      // Create: Cloud Functions handle this (via consumeInvite)
      allow create: if false;
      // Update/Delete: Admins only
      allow update, delete: if isAdmin();
    }
    
    // ============================================================
    // TRAINING DATA (Correction Pairs for AI Fine-Tuning)
    // ============================================================
    
    match /training_data/{docId} {
      // Read: Admins only (for export)
      allow read: if isAdmin();
      // Create: Any authenticated reviewer/admin
      allow create: if isSignedIn() && (isAdmin() || isReviewer());
      // Immutable - no updates or deletes
      allow update, delete: if false;
    }
    
    // ============================================================
    // DENY ALL OTHER ACCESS
    // ============================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
